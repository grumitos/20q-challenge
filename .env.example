# Riot Developer Portal key. Keep the real value in .env.local and in the
# Pages project's secrets.
RIOT_API_KEY=

# Shared secret between `cron-worker` and the site. Pages has no `scheduled`
# handler, so the schedules arrive as POSTs to /api/cron/* carrying this value
# in `x-cron-secret`. It is not a credential for any third party — it only
# proves the call came from the cron Worker. Must be identical in the Pages
# project and in `cron-worker`; while they disagree the endpoints answer 404
# and the schedules stop firing.
CRON_SECRET=
